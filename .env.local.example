# נדרש כדי שהניתוח הסמנטי (Claude) יעבוד. קבלו מפתח ב-https://console.anthropic.com
# העתיקו קובץ זה ל-.env.local (המוגדר כבר ב-.gitignore) והזינו את המפתח האמיתי.
ANTHROPIC_API_KEY=

# --- גישה ותשלום ---
# מסד הנתונים (Neon). נוצר אוטומטית ב-Vercel דרך Storage → Neon.
DATABASE_URL=
# סוד ב-notifyUrl של Grow: https://<domain>/api/grow/webhook?secret=<הערך הזה>
GROW_WEBHOOK_SECRET=
# סוד להנפקת קרדיט ידני דרך /api/admin/credit
ADMIN_SECRET=
# קישור עמוד התשלום ב-Grow (מוצג ללקוח שאין לו קישור גישה)
NEXT_PUBLIC_FULL_AUDIT_PAYMENT_URL=
